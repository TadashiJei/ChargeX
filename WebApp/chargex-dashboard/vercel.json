{
  "version": 2,
  "scripts": {
    "build": "npm install --legacy-peer-deps && next build"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
